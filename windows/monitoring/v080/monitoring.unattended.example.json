{
  "schema_version": 1,
  "profile": "unattended-v080",
  "enabled": false,
  "read_only": true,
  "repair_action": "None",
  "windows": {
    "adapter_name": "Ethernet 3",
    "gateway_ip": "192.168.137.1",
    "receiver_ip": "192.168.137.167",
    "receiver_port": 8765,
    "upstream_interface": "Ethernet"
  },
  "pi": {
    "hostname": "svr-onyxcore.local",
    "user": "onyxpi",
    "monitor_key_path": "%USERPROFILE%\\.ssh\\onyxcore_monitor_ed25519"
  },
  "runtime": {
    "python_executable": "C:\\Python313\\python.exe",
    "ssh_executable": "C:\\Windows\\System32\\OpenSSH\\ssh.exe"
  },
  "schedule": {
    "interval_seconds": 120,
    "startup_grace_seconds": 180,
    "max_cycle_seconds": 120,
    "overlap_policy": "Skip",
    "missed_cycle_policy": "Skip",
    "session_policy": "LoggedOnUserOnly"
  },
  "alerts": {
    "incomplete_cycles_before_warning": 3,
    "notify_on_confirmed_incident": true,
    "notify_on_recovery": true,
    "repeat_identical_alerts": false,
    "channel": "LocalOnly"
  },
  "authorization": {
    "scope": "periodic_read_only_usb_ics",
    "enrollment_path": "%LOCALAPPDATA%\\OnyxCore-v080\\Authorization\\enrollment.json",
    "task_name": "ONYX CORE - USB Monitor",
    "require_account_match": true,
    "require_source_commit_match": true,
    "require_config_digest_match": true
  },
  "state_dir": "%LOCALAPPDATA%\\OnyxCore-v080\\Monitoring"
}
