#!/bin/sh
# Candidate NetworkManager dispatcher. Not installed or enabled by M4.
set -eu
[ "${1:-}" = 'usb0' ] || exit 0
case "${2:-}" in up|dhcp4-change) ;; *) exit 0 ;; esac
unit='onyxcore-v090-receiver.service'
systemctl -q is-active "$unit" || exit 0
new_ip=$(ip -4 -o addr show dev usb0 scope global | awk '$4 ~ /^192[.]168[.]137[.]/ {sub(/\/.*/, "", $4); print $4; exit}')
[ -n "$new_ip" ] || exit 0
pid=$(systemctl show -p MainPID --value "$unit")
case "$pid" in ''|0|*[!0-9]*) exit 0 ;; esac
[ -r "/proc/$pid/cmdline" ] || exit 0
old_ip=$(tr '\000' '\n' < "/proc/$pid/cmdline" | awk 'prior=="--bind" {print; exit} {prior=$0}')
[ -n "$old_ip" ] || exit 0
if [ "$new_ip" != "$old_ip" ]; then
    logger -t onyxcore-v090-dispatcher 'USB lease changed; restarting only candidate receiver'
    systemctl restart "$unit"
fi
